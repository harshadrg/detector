# Server Environment Variables (Private - Never expose to client)
PORT=5000
NODE_ENV=development

# Authentication Secrets
JWT_SECRET=replace_with_secure_random_secret_in_production
JWT_EXPIRES_IN=1d

# Database Configuration (MSSQL)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=detector_db
DB_USER=detector_user
DB_PASSWORD=replace_with_db_password
DB_ENCRYPT=true

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:5173
